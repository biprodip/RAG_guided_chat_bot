# Secrets — must never enter the image
.env
.env.*

# Raw data — embedded into the Pinecone index at index-build time,
# not needed at inference runtime
data/

# Python build artefacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# Version control
.git/
.gitignore

# CI/CD config — not needed inside the container
.github/

# Dev tooling & editor config
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log
.DS_Store